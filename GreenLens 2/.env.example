# ==============================================================================
# GreenLens AI Advanced Backend Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Google Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Local YOLO Computer Vision Weights
YOLO_MODEL_NAME=yolov8n.pt

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Weather & Hydrology Telemetry
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_BASE_URL=http://api.weatherapi.com/v1
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast

# Regional Hydrological Parameters (Ghana Defaults: Winneba)
DEFAULT_LAT=5.34352
DEFAULT_LON=-0.62566
DEFAULT_RUNOFF_COEFFICIENT_C=0.75
DEFAULT_SURCHARGE_THRESHOLD_MM_H=3.0
